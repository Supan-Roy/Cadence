# Google OAuth Configuration
GOOGLE_OAUTH2_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH2_CLIENT_SECRET=your_google_client_secret_here
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
# Choose either SMTP (Gmail, custom server) or Resend API
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=noreply@cadence.music

# Email API Configuration (Optional - Resend Service)
# Set USE_RESEND_API=True to use Resend API instead of SMTP
USE_RESEND_API=False
RESEND_API_KEY=your_resend_api_key_here

# Database
DATABASE_URL=

# Other config
DEBUG=True
SECRET_KEY=your-secret-key-here

# Radio / HLS: full path if `ffmpeg` is not on Django's PATH (common with WinGet installs)
# FFMPEG_BINARY=C:\Users\you\AppData\Local\Microsoft\WinGet\Packages\...\ffmpeg.exe
